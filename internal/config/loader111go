package config

import (
	"errors"
	"flag"
	"os"
	"path/filepath"
	"runtime"

	"gopkg.in/yaml.v3"
)

type Options struct {
	AppName string // edge-orch
	Unit    string // co | lo | era
	Ext     string // yaml | json | toml
}

func LoadPath(opts Options) (string, error) {
	if opts.Ext == "" {
		opts.Ext = "yaml"
	}

	// 1️⃣ CLI flag
	var configFile string
	flag.StringVar(&configFile, "config", "", "Path to config file")
	flag.Parse()

	if configFile != "" {
		if exists(configFile) {
			return configFile, nil
		}
		return "", errors.New("config file not found: " + configFile)
	}

	// 2️⃣ Explicit env vars
	if v := os.Getenv("APP_CONFIG_FILE"); v != "" {
		if exists(v) {
			return v, nil
		}
	}

	// 3️⃣ Config dir override
	if v := os.Getenv("APP_CONFIG_DIR"); v != "" {
		f := filepath.Join(v, fileName(opts))
		if exists(f) {
			return f, nil
		}
	}

	// 4️⃣ OS default
	if f := osDefault(opts); exists(f) {
		return f, nil
	}

	// 5️⃣ Dev fallback
	dev := filepath.Join("config", fileName(opts))
	if exists(dev) {
		return dev, nil
	}

	return "", errors.New("no config file found")
}

func Load(path string, out interface{}) (error) {
	b, err := os.ReadFile(path)
	if err != nil {
		return err
	}

	if err := yaml.Unmarshal(b, out); err != nil {
		return err
	}

	return nil
}

func fileName(o Options) string {
	return o.Unit + "." + o.Ext
}

func osDefault(o Options) string {
	switch runtime.GOOS {
	case "linux":
		return filepath.Join("/etc", o.AppName, o.Unit, fileName(o))

	case "darwin":
		return filepath.Join(
			"/Library/Application Support",
			o.AppName,
			o.Unit,
			fileName(o),
		)

	case "windows":
		base := os.Getenv("ProgramData")
		if base == "" {
			base = `C:\ProgramData`
		}
		return filepath.Join(
			base,
			o.AppName,
			o.Unit,
			"config",
			fileName(o),
		)
	default:
		return ""
	}
}

func exists(path string) bool {
	info, err := os.Stat(path)
	return err == nil && !info.IsDir()
}
